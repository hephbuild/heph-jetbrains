<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.rpc"/>
        <module name="intellij.platform.rpc.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="intellij.platform.lsp"/>
        <module name="intellij.platform.lsp.impl"/>
        <module name="heph-jetbrains.shared"/>
    </dependencies>

    <resource-bundle>messages.HephBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <fileTypeOverrider implementation="io.github.hephbuild.heph.filetype.HephFileTypeOverrider"/>

        <!-- "IconProvider" is the id of the Catppuccin Icons provider; `first` alone ties with it. -->
        <iconProvider implementation="io.github.hephbuild.heph.filetype.HephIconProvider"
                      id="HephIconProvider" order="first, before IconProvider"/>

        <platform.lsp.integrationProvider
                implementation="io.github.hephbuild.heph.lsp.HephLspIntegrationProvider"/>

        <platform.rpc.backend.remoteApiProvider
                implementation="io.github.hephbuild.heph.rpc.HephRemoteApiProvider"/>
    </extensions>

    <applicationListeners>
        <listener class="io.github.hephbuild.heph.filetype.HephConfigFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>
</idea-plugin>
